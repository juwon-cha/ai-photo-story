# ─────────────────────────────────────────────
#  AI Photo Story — 환경변수 예시
#  이 파일을 복사해 .env.local 을 만들고 실제 값을 채우세요.
#  .env.local 은 절대 커밋하지 마세요. (.gitignore 에 포함됨)
# ─────────────────────────────────────────────

# Supabase 프로젝트 설정 → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio 에서 발급 (서버 전용, NEXT_PUBLIC 아님!)
GEMINI_API_KEY=your-gemini-api-key

# (선택) 사용할 Gemini 모델. 비워두면 gemini-2.5-flash 사용.
# 무료 티어에서 gemini-2.0-flash 는 429가 잦아 2.5-flash 를 기본으로 함.
# 필요 시 gemini-1.5-flash 등으로 교체 가능.
# GEMINI_MODEL=gemini-2.5-flash

# 소셜 공유 미리보기(OG)의 기준 주소.
#  - 로컬 개발: 아래 localhost 그대로 둡니다.
#  - 배포(프로덕션): 이 파일을 고치지 말고, Vercel 환경변수에
#    실제 주소(예: https://ai-photo-story.vercel.app)를 넣습니다.
#  ※ 공유 '링크' 자체는 코드에서 현재 접속 주소를 자동으로 사용하므로,
#     이 값을 안 바꿔도 배포 사이트의 공유는 정상 동작합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
